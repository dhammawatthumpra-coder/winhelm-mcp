{
  "blockedCommands": [
    "format-volume",
    "format-disk",
    "clear-disk",
    "stop-computer",
    "restart-computer",
    "rmdir /s /q c:\\",
    "del /f /s /q c:\\",
    "remove-item -recurse -force c:\\"
  ],
  "allowedDirectories": ["*"],
  "allowSystemExecution": true,
  "fileReadLineLimit": 2000,
  "defaultTimeoutMs": 60000,
  "telemetryEnabled": false,
  "authToken": null,
  "readOnly": false,
  "rateLimitPerMinute": 120,
  "profile": "full"
}