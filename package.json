{
  "name": "winhelm-mcp",
  "version": "1.1.0",
  "description": "WinHelm - Windows Native MCP Server with Unified HTTP/SSE/Streamable Gateway and 38 Tools",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "winhelm": "dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "manifest.json",
    "server.json",
    "winhelm.config.example.json",
    "scripts/build-exe.ps1",
    "scripts/manage-service.ps1",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhammawatthumpra-coder/winhelm-mcp.git"
  },
  "homepage": "https://github.com/dhammawatthumpra-coder/winhelm-mcp#readme",
  "bugs": {
    "url": "https://github.com/dhammawatthumpra-coder/winhelm-mcp/issues"
  },
  "author": {
    "name": "dhammawatthumpra-coder",
    "email": "dhammawatthumpra@gmail.com",
    "url": "https://github.com/dhammawatthumpra-coder"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "windows",
    "ai",
    "claude",
    "cursor",
    "automation",
    "powershell",
    "windows-native",
    "llm-tools"
  ],
  "scripts": {
    "prepublishOnly": "npm run build && npm test",
    "build": "rimraf dist && tsc",
    "build:exe": "powershell -ExecutionPolicy Bypass -File scripts/build-exe.ps1",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "dev:type-check": "tsc --noEmit --watch",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "type-check": "tsc --noEmit",
    "service:install": "powershell -ExecutionPolicy Bypass -File scripts/manage-service.ps1 -Action install",
    "service:uninstall": "powershell -ExecutionPolicy Bypass -File scripts/manage-service.ps1 -Action uninstall",
    "service:start": "powershell -ExecutionPolicy Bypass -File scripts/manage-service.ps1 -Action start",
    "service:stop": "powershell -ExecutionPolicy Bypass -File scripts/manage-service.ps1 -Action stop",
    "service:status": "powershell -ExecutionPolicy Bypass -File scripts/manage-service.ps1 -Action status"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.9.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
